# Copie para ".env" e ajuste. Deve bater com as credenciais do docker-compose
# da raiz do projeto (MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE).
NODE_ENV=development
PORT=3000

DATABASE_URL="mysql://sae_app:troque_esta_senha_app@localhost:3306/sae"
# So usado por "prisma migrate dev" para o shadow database (ver comentario em schema.prisma).
SHADOW_DATABASE_URL="mysql://root:troque_esta_senha_root@localhost:3306/sae_shadow"

# Use um valor longo e aleatorio em producao (ex: openssl rand -hex 32)
JWT_SECRET=re007123A!
JWT_EXPIRES_IN=8h

# --- Modulo "IA no WhatsApp" (arquitetura em construcao, ver src/services/ai e src/services/whatsapp) ---

# IA (src/services/ai) - deixe AI_BASE_URL vazia para usar a OpenAI de
# verdade (exige AI_API_KEY real). Para usar um Ollama local (Qwen)
# rodando na propria maquina, descomente as 2 linhas abaixo.
AI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL= (opcional - padrao "gpt-4o-mini" na OpenAI, "qwen2.5" no Ollama)

# WhatsApp (src/services/whatsapp) - "baileys" (QR Code, padrao) ou "meta" (API oficial).
WHATSAPP_PROVIDER=baileys

# So usadas quando WHATSAPP_PROVIDER=meta E a integracao de verdade com a
# Graph API for implementada (MetaApiProvider.js ainda e so um mock) -
# deixadas aqui como lembrete do que vai ser necessario.
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=

# Gateway de pagamento Asaas (2026-09-24) - ver dossie-infraestrutura.md, secao 2.14.
# Chave da conta (Integracoes > Chaves de API). Vazio = checkout real desativado (503).
ASAAS_API_KEY=
# Vazio = SANDBOX (https://api-sandbox.asaas.com/v3). Producao: https://api.asaas.com/v3
ASAAS_API_URL=
# Token do webhook (32-255 caracteres, sem espacos) - o MESMO cadastrado no painel do Asaas.
# Gerar: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
