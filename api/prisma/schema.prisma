// Schema do SAE (Sistema de Apoio Empresarial) - multi-tenant.
//
// Convencao de nomes: campos em camelCase no Prisma Client (idiomatico em
// JS), mapeados via @map/@@map para as colunas/tabelas em snake_case no
// MySQL (convencao já usada no restante do projeto).
//
// IDs: INT UNSIGNED AUTO_INCREMENT (nao BIGINT UNSIGNED). O Prisma mapeia
// BIGINT para o tipo BigInt do JS, que nao serializa em JSON por padrao e
// exigiria conversoes manuais em toda rota. INT UNSIGNED suporta ~4.29
// bilhoes de linhas por tabela - de sobra para um SaaS de pequenos
// negocios - e mapeia para "number" comum, evitando esse atrito.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // "prisma migrate dev" precisa criar/derrubar um banco temporario para
  // calcular o diff de schema. O usuario da aplicacao (sae_app) so tem
  // grants no banco "sae" (concedidos automaticamente pelo docker-compose
  // via MYSQL_USER/MYSQL_DATABASE), sem permissao de CREATE DATABASE - por
  // isso o shadow database usa as credenciais de root, so em dev.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum RoleUsuario {
  admin
  gerente
  vendedor
}

/// Nivel de assinatura da empresa. Nao e um flag "ativo/inativo" - o valor
/// EM SI e o plano atual (gratuito e um estado normal, nao "inativo").
enum PlanoEmpresa {
  gratuito
  apoiador
}

/// Tipo de documento fiscal da empresa - decide se `Empresa.documento` e um
/// CPF (11 digitos, pessoa fisica/MEI) ou um CNPJ (14 digitos, pessoa
/// juridica). Modelado como enum (nao String solto) pelo mesmo motivo de
/// RoleUsuario/PlanoEmpresa acima: valida na propria coluna do MySQL, sem
/// depender so da validacao da aplicacao.
enum TipoPessoa {
  PF
  PJ
}

/// Categoria do evento na Agenda (hub que unifica vendas, contas a pagar/
/// receber e lembretes soltos num so calendario). Enum (nao String solto)
/// pelo mesmo motivo de RoleUsuario/PlanoEmpresa/TipoPessoa acima.
enum TipoTarefa {
  pagamento
  recebimento
  venda
  lembrete
}

/// Forma de pagamento/saida de uma Venda. Enum (nao String solto) porque o
/// conjunto TOTAL de valores possiveis e fixo e conhecido - o que MUDA por
/// empresa e so quais dessas opcoes aparecem no select do PDV
/// (`consumo_interno`/`doacao` so pra `Empresa.segmento === 'varejo_alimentacao'`,
/// ver validacao em vendas.service.js), nao o vocabulario em si. Uma
/// venda com essas 2 formas nao gera Lancamento (nao e dinheiro entrando
/// no caixa) - ver `registrarVenda` em vendas.service.js.
enum FormaPagamento {
  dinheiro
  pix
  cartao_credito
  cartao_debito
  pendente
  consumo_interno
  doacao
}

/// Direcao do Lancamento no caixa da empresa. Em MAIUSCULO (diferente dos
/// enums acima, todos lowercase) porque foi o valor pedido explicitamente
/// nesta tarefa - inconsistencia de convencao sinalizada aqui de proposito,
/// nao um esquecimento.
enum TipoLancamento {
  ENTRADA
  SAIDA
}

/// Situacao de pagamento/recebimento do Lancamento - mesmo motivo do
/// MAIUSCULO acima (valor pedido explicitamente).
enum StatusLancamento {
  PENDENTE
  PAGO
}

/// Tabela "raiz" do modelo multi-tenant: Empresa.id E o tenant_id
/// referenciado por Usuario, Produto e Venda.
model Empresa {
  id                      Int          @id @default(autoincrement()) @db.UnsignedInt
  razaoSocial             String       @map("razao_social") @db.VarChar(150)
  // Apelido/nome fantasia da loja (ex.: usado em recibos e mensagens) -
  // opcional e distinto de `razaoSocial` (a razao social/nome legal, exigida
  // no cadastro). Editavel em Configuracoes > Dados da Loja.
  nomeLoja                String?      @map("nome_loja") @db.VarChar(150)
  tipoPessoa              TipoPessoa   @default(PJ) @map("tipo_pessoa")
  // CPF (11 digitos) ou CNPJ (14 digitos), so numeros, dependendo de
  // `tipoPessoa` - por isso VarChar(14) (tamanho maximo dos dois), nao
  // Char(14) como era so pro CNPJ: Char faz padding com espaco ate o
  // tamanho fixo, o que corromperia um CPF de 11 digitos.
  documento               String       @unique @db.VarChar(14)
  // Opcionais: nem toda empresa cadastrada vai ter preenchido de imediato.
  endereco                String?      @db.VarChar(255)
  telefone                String?      @db.VarChar(20)
  // Nome do campo no Prisma e "plano" (mais claro que carrega o nivel do
  // plano, nao um booleano) - mapeado pra coluna "plano_ativo" no MySQL.
  plano                   PlanoEmpresa @default(gratuito) @map("plano_ativo")
  // Valor mensal que um Apoiador contribui (a "mensalidade caridosa") -
  // Decimal (nao Float) pelo mesmo motivo de Produto.custo/precoVenda
  // abaixo: dinheiro nunca deve usar ponto flutuante binario.
  valorContribuicao       Decimal      @default(0.00) @map("valor_contribuicao") @db.Decimal(10, 2)
  // Coluna persistida (pedido explicito, 2026-09-22) - antes era so um valor
  // CALCULADO em runtime (`plano === 'apoiador'`, nunca gravado). Mantida em
  // sincronia com `plano` nos 2 unicos lugares que escrevem `plano`
  // (`atualizarAssinatura` em empresa.service.js e `definirDoador` em
  // superadmin.service.js - ambos gravam os dois campos na MESMA escrita),
  // entao os dois nunca divergem na pratica, apesar de guardados em colunas
  // separadas agora.
  isDoador                Boolean      @default(false) @map("is_doador")
  // Painel Master - Etapa 3 (2026-09-23): "ha quanto tempo e doador" (data
  // ORIGINAL de quando virou doadora pela 1a vez - preservada em renovacoes/
  // trocas de valor, so reseta se deixar de ser doadora e voltar depois, ver
  // `empresaService.calcularCiclosDoador`) e o ciclo de cobranca simulado
  // (mesmo espirito de `pagamentosAtivos` pros modulos pagos - "agora + 30
  // dias" a cada confirmacao, sem cobranca real nem job automatico). `Boolean
  // isDoador` acima continua a fonte da verdade de "e doador ou nao" - estes
  // 2 campos so complementam com QUANDO comecou e QUANDO vence, ambos `null`
  // pra quem nunca foi/deixou de ser doador.
  doadorDesde             DateTime?    @map("doador_desde")
  doadorProximoVencimento DateTime?    @map("doador_proximo_vencimento")
  // Segmento de atuacao da empresa - gate de regras de negocio pontuais
  // (ex.: so "varejo_alimentacao" desbloqueia Ficha Tecnica de ingredientes
  // em Produto, ver FichaTecnica abaixo, e as formas de pagamento "Consumo
  // Interno"/"Doacao" em Venda). NAO decide mais quais modulos/telas ficam
  // disponiveis (ver `modulosAtivos` abaixo, arquitetura modular de
  // 2026-09-22) - so serve de PONTO DE PARTIDA pros modulos no cadastro
  // (`modulosDoSegmento(segmento)` em auth.service.js#register), depois
  // disso os dois campos evoluem de forma independente. String solto (nao
  // enum), mesmo motivo de sempre: o conjunto de valores aceitos
  // (`SEGMENTOS_VALIDOS`, derivado de `Object.keys(MAPA_MODULOS)` em
  // auth.service.js) pode crescer sem exigir migration. SEM default
  // proposital (campo obrigatorio) - todo cadastro novo (Cadastro.jsx) exige
  // escolher um segmento explicitamente, nao ha mais um "outros" implicito.
  segmento                String       @db.VarChar(30)
  // Arquitetura Modular SaaS (2026-09-22, ultimo passo do roadmap):
  // catalogo de chaves de modulo (String[], as mesmas chaves ja usadas por
  // `ROTAS_POR_MODULO` em web/src/App.jsx e pelos campos `modulo` de
  // web/src/components/Sidebar.jsx) que a EMPRESA (nao mais o segmento)
  // decide ligar/desligar via GET/PUT /empresa/modulos (Modulos.jsx, a
  // "App Store" do SaaS). Json (nao uma tabela relacional `empresas_modulos`)
  // pelo mesmo motivo ja registrado pra `MAPA_MODULOS`: o catalogo e
  // pequeno, JSON evita uma tabela + N queries so pra ler um array curto de
  // strings. Populado no cadastro com `modulosDoSegmento(segmento)` (ver
  // register() em auth.service.js) - so o valor INICIAL, mutavel dali em
  // diante pela empresa. `Json?` (nao `Json` obrigatorio) so por seguranca
  // de schema (linhas antigas sem o campo preenchido) - a aplicacao sempre
  // trata `null` como "usa o default de modulos base", nunca deixa a API
  // devolver `null` pro frontend (ver empresa.service.js).
  modulosAtivos           Json?        @default("[\"vendas\", \"financeiro\", \"produtos\"]") @map("modulos_ativos")
  // Monetizacao dos modulos opcionais (2026-09-22, motor de pricing da
  // App Store): `{ [chaveDoModulo]: true }` pra modulos de preco unico
  // (ex.: `{"pdv_touch": true}`), ou `{ [chaveDoModulo]: "<plano>" }` pro
  // unico modulo com mais de uma oferta (`ia_whatsapp`, guarda qual das 2
  // conexoes foi paga - "whatsapp_web" ou "meta_api"). Json (mesmo motivo
  // de `modulosAtivos` acima - catalogo pequeno, sem tabela relacional) -
  // DISTINTO de `modulosAtivos`: este aqui e o "ja pagou", aquele e o "esta
  // ligado" - um modulo so pode entrar em `modulosAtivos` se antes constar
  // (truthy) aqui, reforcado em `empresaService.atualizarModulos`. NAO
  // reflete pagamento real (nenhum gateway integrado ainda - mesmo espirito
  // "simulado" de `atualizarAssinatura`, ver comentario dela abaixo neste
  // arquivo) - `PUT /empresa/pagamentos` so grava como se a cobranca ja
  // tivesse sido confirmada.
  pagamentosAtivos        Json?        @default("{}") @map("pagamentos_ativos")
  // Suspensao de acesso pelo Supra Admin (Painel Master, 2026-09-22,
  // superadmin.routes.js) - `false` bloqueia login de QUALQUER usuario
  // desta empresa (ver auth.service.js#login). Sessoes JA ABERTAS (JWT
  // valido, ate 8h) continuam funcionando ate expirar - esta arquitetura
  // usa JWT stateless, sem blacklist/revogacao de token ativo; suspender
  // corta o acesso na PROXIMA tentativa de login, nao instantaneamente.
  // Limitacao aceita por enquanto (documentada em NOTAS_IMPORTANTES.md).
  ativo                   Boolean      @default(true)
  criadoEm                DateTime     @default(now()) @map("criado_em")
  atualizadoEm            DateTime     @default(now()) @updatedAt @map("atualizado_em")

  // "ID da Loja" (2026-09-24) - codigo de 5 digitos da EMPRESA, mostrado a
  // TODOS os usuarios dela no Suporte e usado pelo Supra Admin pra
  // identificar o cliente. Antes a tela mostrava `Usuario.codigoUsuario`
  // (pessoal - cada funcionario via um numero diferente). Valor = codigo do
  // admin fundador (backfill na migration + `register()`), entao lojas
  // existentes mantem o numero que o dono ja conhecia. Unico: codigos de
  // usuario ja sao unicos globalmente. Nullable so por seguranca de
  // migracao (empresa sem nenhum admin) - o service gera um se faltar.
  codigoLoja      String?      @unique(map: "uq_empresas_codigo_loja") @map("codigo_loja") @db.VarChar(5)

  usuarios        Usuario[]
  produtos        Produto[]
  vendas          Venda[]
  tarefas         Tarefa[]
  clientes        Cliente[]
  lancamentos     Lancamento[]
  ingredientes    Ingrediente[]
  atendimentos    Atendimento[]
  chamadosSuporte ChamadoSuporte[]
  perfis          Perfil[]

  @@map("empresas")
}

/// Perfil de acesso (RBAC, 2026-09-24) - um "cargo" criado pelo admin da
/// empresa (ex.: Producao, Vendas, Financeiro) com o conjunto de permissoes
/// que ele libera. Cada Usuario (nao-admin) aponta pra no maximo 1 Perfil.
///
/// `permissoes`: Json com um ARRAY de chaves de permissao (ex.:
/// ["VER_VENDAS","VER_CLIENTES"]) - MySQL nao tem tipo array nativo, e uma
/// tabela de juncao perfil<->permissao seria excesso pra um catalogo FIXO
/// definido em codigo (api/src/services/permissoes.js#CATALOGO_PERMISSOES).
/// O service sempre normaliza antes de gravar (so chaves do catalogo, sem
/// duplicata) - nunca confia no array vindo do cliente.
model Perfil {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId    Int      @map("empresa_id") @db.UnsignedInt
  nome         String   @db.VarChar(60)
  permissoes   Json
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  // Cascade: perfis nao existem fora da empresa (tenant) que os criou.
  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  usuarios Usuario[]

  // Nome unico POR empresa (duas empresas podem ter um perfil "Vendas").
  @@unique([empresaId, nome], map: "uq_perfis_empresa_nome")
  @@index([empresaId], map: "idx_perfis_empresa_id")
  @@map("perfis")
}

model Usuario {
  id            Int         @id @default(autoincrement()) @db.UnsignedInt
  empresaId     Int         @map("empresa_id") @db.UnsignedInt
  nome          String      @db.VarChar(120)
  email         String      @db.VarChar(150)
  senhaHash     String      @map("senha_hash") @db.VarChar(255)
  // Permissao DENTRO da empresa/tenant (admin/gerente/vendedor) - continua
  // sem nenhuma rota checando isso ainda (mesma lacuna ja documentada no
  // dossie de infraestrutura), NAO confundir com `nivelAcesso` abaixo.
  role          RoleUsuario @default(vendedor)
  // Nivel de acesso na PLATAFORMA (Painel Supra Admin, 2026-09-22) - eixo
  // SEPARADO de `role` acima de proposito (conferido com o usuario antes
  // de escrever isto): `role` e "que tipo de funcionario dentro desta
  // empresa" (admin/gerente/vendedor, sempre preso a um tenant), enquanto
  // `nivelAcesso` e "que tipo de CONTA na plataforma inteira" - "LOJISTA"
  // (todo usuario comum, dono/funcionario de uma empresa cliente) ou
  // "SUPERADMIN" (o dono do software, unico nivel que enxerga TODAS as
  // empresas via superadmin.routes.js, ignorando isolamento de tenant de
  // proposito). Juntar os dois num campo so misturaria conceitos sem
  // relacao (um SUPERADMIN nao e "admin de uma empresa especifica").
  // String solto (nao enum), mesmo motivo de sempre - so 2 valores usados
  // hoje, sem exigir migration se um 3o nivel aparecer. NUNCA setado pelo
  // cadastro self-service (`register()` sempre grava o default "LOJISTA")
  // - virar SUPERADMIN e uma operacao manual (direto no banco), de
  // proposito: nenhum usuario deve conseguir se auto-promover.
  nivelAcesso   String      @default("LOJISTA") @map("nivel_acesso") @db.VarChar(20)
  // Codigo curto de 5 digitos (2026-09-23, Painel Master - etapa 1) pra
  // identificar o usuario sem expor id/email (ex.: suporte confirmando
  // identidade por telefone). String (nao Int) e zero-padded na geracao
  // ("00042", nao "42") - preserva sempre 5 caracteres, o que um Int
  // perderia (zero a esquerda nao sobrevive num tipo numerico). Unico
  // GLOBALMENTE (nao so por empresa, diferente de email) - e um codigo
  // "cartao de identificacao", faz mais sentido nao repetir entre tenants
  // diferentes. Gerado em auth.service.js#register/empresa.service.js#adicionarUsuario
  // (gerarCodigoUsuario, com checagem de unicidade antes do insert) -
  // nunca escolhido pelo usuario, nunca reaproveitado como credencial de
  // login (email+senha continua sendo o unico jeito de entrar).
  codigoUsuario String      @unique(map: "uq_usuarios_codigo_usuario") @map("codigo_usuario") @db.VarChar(5)
  // Perfil de acesso (RBAC, 2026-09-24) - decide quais paginas/menus e
  // rotas da API este usuario acessa (ver plugins/permissoes.js). Regras:
  //   - role 'admin'  -> acesso TOTAL, perfil ignorado;
  //   - perfilId set  -> so as permissoes do perfil;
  //   - perfilId null (nao-admin) -> acesso total LEGADO (usuarios criados
  //     antes do RBAC; o convite novo sempre exige perfil).
  // `onDelete: Restrict` DE PROPOSITO (nao SetNull): se apagar o perfil
  // zerasse este campo, o usuario cairia no caso "null" e GANHARIA acesso
  // total - escalada de privilegio. O service tambem recusa (409) antes.
  // O perfil precisa ser da MESMA empresa do usuario - garantido no
  // service (a FK sozinha nao checa tenant).
  perfilId      Int?        @map("perfil_id") @db.UnsignedInt
  // "Remover da equipe" (2026-09-24) = DESATIVAR, nao apagar: toda FK que
  // aponta pra Usuario (vendas, consumo interno, tarefas, chamados) e
  // Restrict - apagar quem ja vendeu perderia o autor do historico. Inativo:
  // login recusado e QUALQUER sessao aberta cai na proxima requisicao (o
  // acesso e lido do banco a cada request, plugins/permissoes.js). Nao conta
  // no limite de usuarios do plano; convidar o mesmo e-mail de novo REATIVA.
  ativo         Boolean     @default(true)
  // Senha temporaria (convite ou "Redefinir senha" pelo admin) - enquanto
  // true, a API so aceita GET /auth/me e PUT /auth/senha (403
  // TROCA_SENHA_OBRIGATORIA no resto) e o frontend mostra so a tela de
  // troca de senha. Vira false quando a propria pessoa define a senha dela.
  deveTrocarSenha Boolean   @default(false) @map("deve_trocar_senha")
  criadoEm      DateTime    @default(now()) @map("criado_em")
  atualizadoEm  DateTime    @default(now()) @updatedAt @map("atualizado_em")

  empresa           Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  perfil            Perfil?          @relation(fields: [perfilId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // 2 relacoes distintas com Venda (quem vendeu vs. quem consumiu
  // internamente) - precisam de nome pra o Prisma saber diferenciar qual
  // FK cada uma representa (ver Venda.usuarioId/funcionarioId acima).
  vendas            Venda[]          @relation("VendaVendedor")
  consumosInternos  Venda[]          @relation("VendaFuncionarioConsumo")
  tarefasAtribuidas Tarefa[]
  chamadosAbertos   ChamadoSuporte[]

  // Email e unico apenas DENTRO da mesma empresa, nao globalmente - dois
  // tenants diferentes podem ter usuarios com o mesmo e-mail.
  @@unique([empresaId, email], map: "uq_usuarios_empresa_email")
  @@index([empresaId], map: "idx_usuarios_empresa_id")
  @@index([perfilId], map: "idx_usuarios_perfil_id")
  @@map("usuarios")
}

model Produto {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId     Int      @map("empresa_id") @db.UnsignedInt
  nome          String   @db.VarChar(150)
  custo         Decimal  @default(0.00) @db.Decimal(12, 2)
  precoVenda    Decimal  @default(0.00) @map("preco_venda") @db.Decimal(12, 2)
  estoqueAtual  Int      @default(0) @map("estoque_atual")
  estoqueMinimo Int      @default(0) @map("estoque_minimo")
  // Produto "sob encomenda" (feito na hora, sem controle de estoque
  // tradicional) - por enquanto so um campo informativo, nenhuma regra de
  // negocio (ex.: pular checagem de estoque em vendas.service.js) foi
  // implementada ainda em cima dele.
  sobDemanda    Boolean  @default(false) @map("sob_demanda")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  empresa      Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // A relacao direta com Venda virou VendaItem nesta tarefa (ver
  // comentario no model Venda) - um produto agora aparece em varias
  // vendas atraves dos itens delas, nao mais um FK direto.
  vendaItens   VendaItem[]
  // So populado (via API) quando a empresa e do segmento "varejo_alimentacao" -
  // ver FichaTecnica abaixo e a validacao em produtos.service.js.
  fichaTecnica FichaTecnica[]

  @@index([empresaId], map: "idx_produtos_empresa_id")
  @@index([empresaId, nome], map: "idx_produtos_empresa_nome")
  @@index([empresaId, estoqueAtual], map: "idx_produtos_empresa_estoque")
  @@map("produtos")
}

/// Cabecalho da venda - QUEM comprou, QUANDO, COMO pagou. Os itens
/// (produto/quantidade/preco) moraram aqui ate esta tarefa ("1 produto por
/// venda", decisao registrada quando o modulo nasceu) - extraidos pra
/// VendaItem abaixo porque o Historico de Vendas agora precisa listar
/// carrinhos com varios produtos, evolucao ja prevista na decisao
/// original.
model Venda {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  empresaId      Int            @map("empresa_id") @db.UnsignedInt
  usuarioId      Int            @map("usuario_id") @db.UnsignedInt
  // Opcional: nem toda venda tem um cliente identificado (venda avulsa de
  // balcao, por exemplo) - exibido como "Avulso" no Historico de Vendas.
  clienteId      Int?           @map("cliente_id") @db.UnsignedInt
  // Funcionario que CONSUMIU o produto - so preenchido quando
  // `formaPagamento = consumo_interno` (empresas do segmento
  // "varejo_alimentacao", ver Empresa.segmento e a validacao em
  // vendas.service.js). Restrict (nao SetNull) pelo mesmo motivo de
  // usuario abaixo: preserva o vinculo, nao deixa apagar um usuario que
  // ja consta em consumo interno registrado.
  funcionarioId  Int?           @map("funcionario_id") @db.UnsignedInt
  formaPagamento FormaPagamento @default(dinheiro) @map("forma_pagamento")
  total          Decimal        @default(0.00) @db.Decimal(12, 2)
  // Data da venda escolhida no PDV (o usuario pode registrar uma venda
  // retroativa, nao e sempre "agora") - so a parte de calendario importa,
  // sem hora (mesmo padrao ja usado em Lancamento.dataVencimento, ver
  // utils/datas.js no frontend).
  data           DateTime       @default(now())
  // So preenchida pras formas de pagamento que representam dinheiro
  // recebido de fato (dinheiro/pix/cartao de credito/debito) - fica NULL
  // pra 'pendente' (ainda nao recebido) e pra 'consumo_interno'/'doacao'
  // (nunca vira dinheiro no caixa). Ver `registrarVenda` em
  // vendas.service.js.
  dataPagamento  DateTime?      @map("data_pagamento")
  criadoEm       DateTime       @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Nao permite apagar um usuario que ja registrou vendas (preserva historico financeiro).
  usuario     Usuario     @relation("VendaVendedor", fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Restrict (nao SetNull) pelo mesmo motivo de usuario acima - preserva o
  // vinculo financeiro entre venda e cliente; apagar um cliente com vendas
  // registradas nao e permitido.
  cliente     Cliente?    @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  funcionario Usuario?    @relation("VendaFuncionarioConsumo", fields: [funcionarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  itens       VendaItem[]

  @@index([empresaId], map: "idx_vendas_empresa_id")
  @@index([empresaId, data], map: "idx_vendas_empresa_data")
  @@index([usuarioId], map: "idx_vendas_usuario_id")
  @@index([clienteId], map: "idx_vendas_cliente_id")
  @@index([funcionarioId], map: "idx_vendas_funcionario_id")
  @@map("vendas")
}

/// Item de uma Venda (produto + quantidade + preco no momento da compra) -
/// extraido de Venda nesta tarefa (ver comentario acima dela). Preco fica
/// congelado aqui no momento da venda (nao le mais Produto.precoVenda
/// depois) - historico financeiro nao deve mudar se o preco do produto for
/// reajustado no futuro.
model VendaItem {
  id            Int     @id @default(autoincrement()) @db.UnsignedInt
  vendaId       Int     @map("venda_id") @db.UnsignedInt
  produtoId     Int     @map("produto_id") @db.UnsignedInt
  quantidade    Int     @default(1)
  precoUnitario Decimal @default(0.00) @map("preco_unitario") @db.Decimal(12, 2)
  subtotal      Decimal @default(0.00) @db.Decimal(12, 2)

  // Cascade: um item nao tem sentido sem a venda-pai.
  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (nao Cascade) - mesmo motivo do antigo Venda.produtoId:
  // preserva o historico de vendas, nao permite apagar um produto que ja
  // foi vendido.
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([vendaId], map: "idx_venda_itens_venda_id")
  @@index([produtoId], map: "idx_venda_itens_produto_id")
  @@map("venda_itens")
}

/// Cadastro simples de clientes, usado pra atrelar vendas a uma pessoa
/// identificada (opcional - ver Venda.clienteId). CRUD "basico" por
/// enquanto: so criar e listar (clientes.controller.js) - editar/excluir
/// ficam pra uma proxima tarefa.
/// Cadastro de clientes + CRM basico (Perfil 360). CRUD completo desde esta
/// tarefa (criar/listar/atualizar - excluir continua fora de escopo, ver
/// clientes.service.js). `statusCrm` classifica o cliente no funil de
/// vendas (Lead/Em Negociacao/Cliente Ativo/Inativo) - editavel pela
/// equipe no Perfil 360 (ver ModalPerfil360.jsx no frontend). String solto
/// (nao enum), mesmo motivo de `Empresa.segmento`: a validacao do
/// conjunto aceito mora na aplicacao (`STATUS_CRM_VALIDOS` em
/// clientes.service.js), nao no banco.
model Cliente {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId    Int      @map("empresa_id") @db.UnsignedInt
  nome         String   @db.VarChar(120)
  telefone     String?  @db.VarChar(20)
  email        String?  @db.VarChar(150)
  statusCrm    String   @default("Lead") @map("status_crm") @db.VarChar(20)
  dataCadastro DateTime @default(now()) @map("data_cadastro")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vendas       Venda[]
  atendimentos Atendimento[]

  @@index([empresaId], map: "idx_clientes_empresa_id")
  @@map("clientes")
}

/// Tabela dupla-funcao: (1) alimenta a Agenda (agenda.service.js - so as
/// tarefas COM `dataVencimento` preenchida entram no calendario, filtradas
/// por intervalo de data) e (2) e a unidade do Quadro de Tarefas Kanban
/// (modulo de Produtividade, ver tarefas.service.js). As duas features
/// dividem a mesma tabela de proposito ("consolidar", pedido explicito
/// desta tarefa) - uma tarefa do Kanban sem data de vencimento so nao
/// aparece na Agenda (a query dela exclui `dataVencimento` nula
/// naturalmente), sem precisar de 2 tabelas separadas.
///
/// `status` (String solto, mesmo motivo de Cliente.statusCrm/
/// Atendimento.status - o conjunto valido, A_FAZER/EM_ANDAMENTO/CONCLUIDO,
/// mora em `tarefas.service.js`, nao no banco) substituiu o antigo
/// `statusConcluida` Boolean nesta tarefa - `agenda.service.js#tarefaParaEvento`
/// foi ajustado pra derivar `statusConcluida: status === 'CONCLUIDO'`,
/// preservando o contrato de evento que Agenda.jsx ja consome, sem quebrar
/// nada la.
model Tarefa {
  id             Int        @id @default(autoincrement()) @db.UnsignedInt
  empresaId      Int        @map("empresa_id") @db.UnsignedInt
  titulo         String     @db.VarChar(150)
  // Opcional: nem todo evento (ex.: uma venda) precisa de detalhamento extra.
  descricao      String?    @db.VarChar(500)
  // Opcional (diferente de Lancamento.dataVencimento, sempre obrigatoria) -
  // uma tarefa do Kanban pode nao ter prazo definido.
  dataVencimento DateTime?  @map("data_vencimento")
  // Default 'lembrete' - toda tarefa criada pelo Quadro Kanban (sem passar
  // `tipo` explicito) cai nesse valor, o unico dos 4 que representa um item
  // "solto" (os outros 3 vem de Lancamento/Venda, ver agenda.service.js).
  tipo           TipoTarefa @default(lembrete)
  status         String     @default("A_FAZER") @db.VarChar(20)
  responsavelId  Int?       @map("responsavel_id") @db.UnsignedInt
  criadoEm       DateTime   @default(now()) @map("criado_em")
  atualizadoEm   DateTime   @default(now()) @updatedAt @map("atualizado_em")

  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (nao SetNull) - mesmo motivo ja usado em Venda.clienteId/
  // funcionarioId: preserva o historico de quem era responsavel, nao deixa
  // apagar um usuario que ainda tem tarefa atribuida a ele.
  responsavel Usuario? @relation(fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([empresaId], map: "idx_tarefas_empresa_id")
  // Consulta real de toda tela de Agenda: "tarefas desta empresa neste mes"
  // (WHERE empresa_id = ? AND data_vencimento BETWEEN ? AND ?).
  @@index([empresaId, dataVencimento], map: "idx_tarefas_empresa_data")
  // Consulta do Quadro Kanban: "tarefas desta empresa, filtrando por status
  // e/ou responsavel" (tarefas.service.js).
  @@index([empresaId, status], map: "idx_tarefas_empresa_status")
  @@index([empresaId, responsavelId], map: "idx_tarefas_empresa_responsavel")
  @@map("tarefas")
}

/// Motor de Lancamentos: receitas e despesas avulsas da loja (contas a
/// pagar/receber que nao vem de uma Venda) - base do modulo financeiro.
/// CRUD completo desde o inicio (diferente de Cliente/Tarefa acima, que
/// nasceram so com create/list) porque foi isso que a tarefa pediu.
model Lancamento {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  empresaId      Int              @map("empresa_id") @db.UnsignedInt
  descricao      String           @db.VarChar(200)
  // Decimal (nao Float) - mesmo motivo de Produto.custo/precoVenda e
  // Empresa.valorContribuicao: dinheiro nunca usa ponto flutuante binario.
  valor          Decimal          @db.Decimal(12, 2)
  tipo           TipoLancamento
  dataVencimento DateTime         @map("data_vencimento")
  // Opcional: so preenchido quando o lancamento e efetivamente baixado
  // (status muda pra PAGO nesse momento).
  dataPagamento  DateTime?        @map("data_pagamento")
  status         StatusLancamento @default(PENDENTE)
  // Bucket do DRE (Demonstrativo do Resultado do Exercicio) - separa
  // Receitas/Custos Variaveis/Custos Fixos/Deducoes (impostos). String
  // solto (nao enum), mesmo motivo de Empresa.segmento/Cliente.statusCrm: a
  // validacao do conjunto aceito mora na aplicacao
  // (`CATEGORIAS_VALIDAS`/`BUCKET_DRE_POR_CATEGORIA` em
  // lancamentos.service.js, reaproveitado por relatorios.service.js#gerarDRE),
  // nao no banco. Substitui a heuristica de palavras-chave que o frontend
  // usava ate esta tarefa pra "adivinhar" a categoria a partir da
  // `descricao` (ver historico do filtro em Lancamentos.jsx) - agora e um
  // dado real, escolhido pelo usuario no cadastro (ModalLancamento.jsx).
  categoria      String           @default("outros") @db.VarChar(30)
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @default(now()) @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([empresaId], map: "idx_lancamentos_empresa_id")
  // Consulta provavel da tela de Lancamentos: "contas desta empresa por
  // vencimento" (fluxo de caixa/lista ordenada por data).
  @@index([empresaId, dataVencimento], map: "idx_lancamentos_empresa_vencimento")
  // Consulta provavel: "pendencias desta empresa" (filtro por status).
  @@index([empresaId, status], map: "idx_lancamentos_empresa_status")
  @@map("lancamentos")
}

/// Materia-prima de empresas do segmento "varejo_alimentacao" (ver Empresa.segmento) -
/// insumos usados na producao dos produtos, com controle de estoque
/// proprio, separado do estoque de Produto (que conta unidades PRONTAS
/// pra vender, nao os ingredientes que as compoem).
model Ingrediente {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId     Int      @map("empresa_id") @db.UnsignedInt
  nome          String   @db.VarChar(120)
  // "kg", "g", "l", "ml", "un" etc - String solto (nao enum), mesmo motivo
  // de Empresa.nicho acima (pedido explicito da tarefa); validado na
  // aplicacao via `UNIDADES_MEDIDA_VALIDAS` (ingredientes.service.js).
  unidadeMedida String   @map("unidade_medida") @db.VarChar(10)
  // Decimal (nao Float) - mesmo motivo de Produto.custo/precoVenda: dinheiro
  // nunca usa ponto flutuante binario.
  custoUnitario Decimal  @default(0.00) @map("custo_unitario") @db.Decimal(12, 2)
  // Decimal (nao Int, diferente de Produto.estoqueAtual) - ingrediente e
  // medido em unidade de massa/volume/unidade (kg, l, un), entao o estoque
  // pode ser fracionario (ex.: "2.500 kg de farinha restantes"). 3 casas
  // decimais cobre precisao de grama dentro de um total em kg.
  estoqueAtual  Decimal  @default(0.000) @map("estoque_atual") @db.Decimal(12, 3)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  empresa      Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fichaTecnica FichaTecnica[]

  @@index([empresaId], map: "idx_ingredientes_empresa_id")
  @@index([empresaId, nome], map: "idx_ingredientes_empresa_nome")
  @@map("ingredientes")
}

/// Status do Atendimento (conversa de WhatsApp com um Cliente) - String solto
/// (nao enum), mesmo motivo de Cliente.statusCrm/Empresa.segmento: o
/// conjunto aceito (`STATUS_ATENDIMENTO_VALIDOS` em atendimentos.service.js)
/// mora na aplicacao, nao no banco.
///
/// Inbox Unificado de WhatsApp: cada numero de telefone que conversa com a
/// empresa tem no maximo 1 Atendimento ABERTO por vez (webhook procura um
/// aberto existente antes de criar outro, ver whatsapp.service.js) - o
/// historico de conversas encerradas fica preservado como Atendimentos
/// FECHADOs, nao apagado nem reaproveitado.
model Atendimento {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId   Int      @map("empresa_id") @db.UnsignedInt
  clienteId   Int      @map("cliente_id") @db.UnsignedInt
  status      String   @default("ABERTO") @db.VarChar(10)
  // Handoff IA -> Humano: true = o AiProvider responde automaticamente a
  // cada mensagem recebida (ver whatsapp.service.js#processarMensagemRecebida);
  // a equipe pode desligar na tela do Inbox pra assumir a conversa sozinha,
  // sem a IA interferir nas proximas mensagens desse cliente.
  iaAtiva     Boolean  @default(true) @map("ia_ativa")
  dataCriacao DateTime @default(now()) @map("data_criacao")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (nao Cascade) - mesmo motivo ja usado em Venda.clienteId:
  // preserva o historico de conversas, nao permite apagar um cliente que ja
  // tem atendimento registrado.
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mensagens Mensagem[]

  @@index([empresaId], map: "idx_atendimentos_empresa_id")
  // Consulta do webhook a cada mensagem recebida: "existe um atendimento
  // ABERTO pra este cliente desta empresa?" (WHERE empresa_id = ? AND
  // cliente_id = ? AND status = 'ABERTO').
  @@index([empresaId, clienteId, status], map: "idx_atendimentos_empresa_cliente_status")
  @@map("atendimentos")
}

/// Mensagem individual dentro de um Atendimento - `remetente` distingue quem
/// escreveu (CLIENTE = mensagem recebida via WhatsApp, BOT = resposta gerada
/// pelo AiProvider, HUMANO = mensagem manual enviada pela equipe no Inbox).
/// String solto (nao enum), mesmo motivo de Atendimento.status.
model Mensagem {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  atendimentoId Int      @map("atendimento_id") @db.UnsignedInt
  remetente     String   @db.VarChar(10)
  // Texto livre da mensagem - sem limite curto de proposito (respostas da
  // IA podem ser longas); mesma escolha ja usada em Lancamento.descricao
  // pra campos de texto sem tamanho previsivel.
  conteudo      String   @db.Text
  timestamp     DateTime @default(now())

  // Cascade: uma mensagem nao tem sentido sem o atendimento-pai.
  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Consulta principal da tela de chat: "mensagens deste atendimento em
  // ordem cronologica" (WHERE atendimento_id = ? ORDER BY timestamp).
  @@index([atendimentoId, timestamp], map: "idx_mensagens_atendimento_timestamp")
  @@map("mensagens")
}

/// Tabela relacional: define quais ingredientes (e em que quantidade) compoem
/// um Produto - a "receita"/ficha tecnica usada por empresas do segmento
/// "varejo_alimentacao". Sem `empresa_id` proprio (o pedido especificou so
/// id/produto_id/ingrediente_id/quantidade_usada) - o isolamento de tenant
/// e garantido indiretamente, exigindo que tanto `produtoId` quanto
/// `ingredienteId` pertencam ao `tenantId` do request antes de gravar
/// (ver produtos.service.js).
model FichaTecnica {
  id              Int     @id @default(autoincrement()) @db.UnsignedInt
  produtoId       Int     @map("produto_id") @db.UnsignedInt
  ingredienteId   Int     @map("ingrediente_id") @db.UnsignedInt
  // Quantidade do ingrediente consumida por 1 unidade do produto (mesma
  // unidade de medida do Ingrediente - ex.: 0.150 kg de farinha por pao).
  quantidadeUsada Decimal @map("quantidade_usada") @db.Decimal(12, 3)

  // Cascade: a ficha tecnica nao tem sentido sem o produto - apagar o
  // produto apaga sua receita junto.
  produto     Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (nao Cascade) - mesma logica ja usada em Venda.produtoId/
  // usuarioId: nao permite apagar um ingrediente que ja esta em uso numa
  // receita, pra nao quebrar a ficha tecnica de um produto silenciosamente.
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Um ingrediente so pode aparecer 1 vez na receita de um mesmo produto -
  // pra ajustar a quantidade de um ingrediente ja vinculado, atualiza a
  // linha existente em vez de duplicar.
  @@unique([produtoId, ingredienteId], map: "uq_ficha_tecnica_produto_ingrediente")
  @@index([produtoId], map: "idx_ficha_tecnica_produto_id")
  @@index([ingredienteId], map: "idx_ficha_tecnica_ingrediente_id")
  @@map("ficha_tecnica")
}

/// Chamado de suporte aberto por uma empresa (pages/Suporte.jsx) - visivel
/// pro Supra Admin na aba "Chamados de Suporte" (superadmin.routes.js).
/// `status` String solto (nao enum), mesmo motivo de sempre
/// (STATUS_CHAMADO_VALIDOS em chamados.service.js).
model ChamadoSuporte {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  empresaId Int      @map("empresa_id") @db.UnsignedInt
  // Quem abriu o chamado (Ajuste no Formulario de Suporte, 2026-09-23) -
  // sempre gravado a partir de `request.userId` (o token JWT de quem esta
  // logado), NUNCA de um valor mandado no corpo da requisicao - mesmo
  // principio ja aplicado a `empresaId` (tenant isolation, ver
  // plugins/auth.js): o campo "Seu ID" no formulario (Suporte.jsx) e
  // so-leitura NA TELA, mas isso e so uma cortesia de UX, nao uma fronteira
  // de seguranca - um usuario mais tecnico poderia editar o corpo da
  // requisicao a mao, entao o backend NUNCA confia no que o cliente manda
  // aqui, so no que o proprio JWT ja provou. `Int?` (nao obrigatorio) -
  // chamados criados ANTES desta tarefa nao tem essa informacao, ficam com
  // `NULL` (nao um usuario "desconhecido" fabricado so pra preencher).
  usuarioId Int?     @map("usuario_id") @db.UnsignedInt
  titulo    String   @db.VarChar(150)
  // Opcional - o pedido original listou so id/empresaId/titulo/status/data,
  // mas um chamado sem nenhum detalhe alem do titulo seria pouco util pra
  // quem for atender - reaproveita o campo "Descrição" que o formulario de
  // Suporte.jsx ja pedia (so nao persistia antes desta tarefa).
  descricao String?  @db.VarChar(1000)
  // Valores (Chat de Suporte, 2026-09-23): ABERTO (padrao, recem-criado),
  // EM_ANALISE, SENDO_SOLUCIONADO, RESOLVIDO - validados em
  // superadmin.service.js#STATUS_CHAMADO_VALIDOS. Continua String (nao
  // enum) pra nao exigir ALTER de tipo em producao a cada status novo.
  status    String   @default("ABERTO") @db.VarChar(20)
  criadoEm  DateTime @default(now()) @map("criado_em")
  // "Data da ultima alteracao" do cabecalho do chat (Chat de Suporte,
  // 2026-09-23) - `@updatedAt` atualiza em toda escrita do chamado (troca
  // de status, e o service tambem "toca" o chamado a cada mensagem nova).
  // `@default(now())` junto de proposito: a migration cria a coluna
  // NOT NULL numa tabela que ja tem linhas em producao - sem DEFAULT o
  // MySQL nao tem valor pra preencher as linhas existentes.
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  // Cascade: historico de chamados nao tem sentido preservado se a empresa
  // inteira for removida.
  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mensagens MensagemChamado[]
  // Restrict (nao Cascade) - mesmo motivo ja usado em Tarefa.responsavel:
  // preserva o historico do chamado (quem abriu), nao permite apagar um
  // usuario que ja tem chamado registrado.
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([empresaId], map: "idx_chamados_suporte_empresa_id")
  @@index([usuarioId], map: "idx_chamados_suporte_usuario_id")
  @@map("chamados_suporte")
}

/// Quem mandou uma MensagemChamado - o lojista que abriu o chamado ou a
/// equipe do Supra Admin. Enum (nao String solto) pelo mesmo motivo de
/// RoleUsuario/TipoPessoa: conjunto fechado, validado na propria coluna.
/// MAIUSCULO seguindo TipoLancamento/StatusLancamento (valores pedidos).
enum RemetenteMensagem {
  LOJISTA
  ADMIN
}

/// Tipo de conteudo de uma MensagemChamado.
enum TipoMensagemChamado {
  TEXTO
  AUDIO
}

/// Mensagem do chat de um ChamadoSuporte (Chat de Suporte, 2026-09-23) -
/// transforma o chamado de formulario estatico em conversa bidirecional
/// (1 chamado : N mensagens). A `descricao` original do chamado continua
/// no proprio ChamadoSuporte (nao e duplicada aqui como "mensagem 0") - o
/// frontend a exibe como o primeiro balao do chat.
///
/// `conteudo`: texto da mensagem (TEXTO) OU o caminho relativo do arquivo
/// de audio salvo em disco pela API (AUDIO, ex.:
/// "chamados/12/1695480000000-ab12cd.webm") - nunca o audio em base64 (um
/// audio de 1 min em base64 passa de ~500 KB, inflaria a tabela e toda
/// listagem do chat). TEXT (ate 64 KB) cobre os dois casos com folga.
model MensagemChamado {
  id           Int                 @id @default(autoincrement()) @db.UnsignedInt
  chamadoId    Int                 @map("chamado_id") @db.UnsignedInt
  remetente    RemetenteMensagem
  tipoMensagem TipoMensagemChamado @default(TEXTO) @map("tipo_mensagem")
  conteudo     String              @db.Text
  criadoEm     DateTime            @default(now()) @map("created_at")

  // Cascade: mensagens nao tem sentido sem o chamado (que por sua vez ja
  // cai em cascata junto com a empresa).
  chamado ChamadoSuporte @relation(fields: [chamadoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Chat sempre lido "mensagens do chamado X em ordem cronologica" -
  // indice composto cobre o where + orderBy de uma vez.
  @@index([chamadoId, criadoEm], map: "idx_mensagens_chamado_chamado_criado")
  @@map("mensagens_chamado")
}

/// Configuracao global de precos dos modulos pagos (Supra Admin, aba
/// "Configuracoes Globais") - SINGLETON, sempre 1 linha so (o service usa
/// `findFirst`, cria a linha na primeira leitura se nao existir ainda, ver
/// configuracoes.service.js - nao ha um id fixo assumido de proposito).
/// Consultada por Modulos.jsx (GET /configuracoes/precos, liberado pra
/// qualquer usuario autenticado, nao so SUPERADMIN) em vez de precos fixos
/// no frontend - o pedido explicita que uma mudanca aqui precisa refletir
/// pra TODOS os clientes, entao os precos nao podiam continuar sendo uma
/// constante hardcoded em Modulos.jsx.
model ConfiguracaoGlobal {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  // Formato: `{ pdv_touch, clientes, tarefas, notas_fiscais: number,
  // ia_whatsapp: { whatsapp_web, meta_api: number } }` - mesmas chaves de
  // modulo/plano ja usadas em `MODULOS_PAGOS`/`PLANOS_IA_WHATSAPP`
  // (empresa.service.js/Modulos.jsx). Json (nao colunas separadas) pelo
  // mesmo motivo de sempre - catalogo pequeno e sujeito a crescer sem
  // exigir migration.
  precosModulos Json     @default("{}") @map("precos_modulos")
  atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("configuracoes_globais")
}
