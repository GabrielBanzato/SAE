# Copie este arquivo para ".env" e ajuste os valores antes de subir o container.
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=sae
MYSQL_USER=sae_app
MYSQL_PASSWORD=troque_esta_senha_app
MYSQL_PORT=3306

# Use um valor longo e aleatorio em producao (ex: openssl rand -hex 32)
JWT_SECRET=troque_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=8h
