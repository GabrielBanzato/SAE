# Copie este arquivo para ".env" e ajuste os valores antes de subir o container.
MYSQL_ROOT_PASSWORD=troque_esta_senha_root
MYSQL_DATABASE=sae
MYSQL_USER=sae_app
MYSQL_PASSWORD=troque_esta_senha_app
MYSQL_PORT=3306

# Use um valor longo e aleatorio em producao (ex: openssl rand -hex 32)
JWT_SECRET=troque_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=8h

# Token do túnel Cloudflare (Zero Trust > Networks > Tunnels > seu túnel > Configure)
TUNNEL_TOKEN=troque_pelo_token_do_seu_tunnel

# Gateway de pagamento Asaas (2026-09-24) - ver dossie-infraestrutura.md, secao 2.14.
# Chave da conta (Integracoes > Chaves de API). Vazio = checkout real desativado (503).
ASAAS_API_KEY=
# Vazio = SANDBOX (https://api-sandbox.asaas.com/v3). Producao: https://api.asaas.com/v3
ASAAS_API_URL=
# Token do webhook (32-255 caracteres, sem espacos) - o MESMO cadastrado no painel do Asaas.
# Gerar: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
